# The acceptance run's environment: 1Password secret references (op://<vault>/<item>/<field>), never the values.
# Copy to acceptance/op.env (ignored by Git) and fill in the references; `op run --env-file acceptance/op.env`
# resolves them into the run's environment only.

# vtadevbot's token (the PRD: provided by Lumi through 1Password).
TELEGRAM_BOT_TOKEN=op://VAULT/ITEM/FIELD
# The acceptance agent's model key; the variable is the provider's (ANTHROPIC_API_KEY for --provider anthropic).
ANTHROPIC_API_KEY=op://VAULT/ITEM/FIELD
# Optional: the owner's numeric Telegram user id. Without it the first run asks the owner to message the bot
# and saves the id under ~/.local/state/hermes-telegram-acceptance/.
# TELEGRAM_OWNER_ID=
